---
layout: none
---
{% comment %} Copyright (c) 2024-2026 Jericho Crosby (Chalwk). All Rights Reserved. {% endcomment %}
{% assign all_posts = site.articles | sort: "date" | reverse %}
[
  {% for post in all_posts %}
    {% if post.description %}{% assign excerpt_text = post.description | strip_html %}{% else %}{% assign excerpt_text = post.excerpt | strip_html | truncatewords: 30 %}{% endif %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "date": {{ post.date | date: "%B %-d, %Y" | jsonify }},
      "excerpt": {{ excerpt_text | jsonify }},
      "categories": {{ post.categories | default: empty | jsonify }},
      "tags": {{ post.tags | default: empty | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]