{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Jekyll: Serve",
			"dependsOn": [
				"Jekyll: Start Server",
				"Jekyll: Open Browser"
			],
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Jekyll: Start Server",
			"type": "shell",
			"command": "bundle",
			"args": [
				"exec",
				"jekyll",
				"serve",
				"--livereload",
				"--host",
				"127.0.0.1",
				"--port",
				"4000"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "jekyll",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Configuration file:",
					"endsPattern": "Server address: http://127\\.0\\.0\\.1:4000/?$"
				}
			}
		},
		{
			"label": "Jekyll: Open Browser",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Start-Process 'http://127.0.0.1:4000/'"
			],
			"problemMatcher": []
		}
	]
}